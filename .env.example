# Comma-separated key pool (at least 2). Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your_key_1,your_key_2
# SQLite location (4 slashes = absolute path). In Docker this lives on the named volume at /data.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure header (must be true on the deployed backend for the demo)
ENABLE_FAILURE_SIMULATION=true
# LiteLLM model name used for every request
DEFAULT_MODEL=gemini/gemini-3.5-flash-lite

# --- optional ---
# Default system prompt when the client does not send one
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# Per-call provider timeout in seconds
LLM_TIMEOUT_SECONDS=60
# How long LiteLLM keeps cached responses in memory (seconds)
CACHE_TTL_SECONDS=86400
# Frontend: backend URL baked into / injected into the SPA
VITE_API_URL=http://localhost:8000
